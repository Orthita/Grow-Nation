# Copy this file to ".env" and fill in your own values. Never share or commit .env.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=grow_nation

# Long random text (32+ characters). Used to sign admin logins and encrypt 2FA keys.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_please

# Set to true once the site runs on HTTPS (production)
COOKIE_SECURE=false

# First Super admin (used only by `npm run init-db` when no users exist).
# If ADMIN_PASSWORD is empty or shorter than 10 characters, a random one is printed.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Email for new enquiries (optional; without SMTP the enquiry is still saved)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Grow Nation <no-reply@example.com>
