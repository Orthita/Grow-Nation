# Copy this file to ".env" and fill in your own values. Never share or commit .env.

# "development" on your own computer, "production" on the live server.
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=grow_nation

# Long random text (32+ characters). Used to sign admin logins.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_please

# A second, different long random text (32+ characters), used only to encrypt two-step login (2FA) keys.
# Required in production: the site will not start without it. Generate it with the same command as above.
# Set it before anyone turns on two-step login. If you change it later, everyone must set up 2FA again.
TOTP_KEY=

# Login cookie over HTTPS only. In production it is always on, whatever you put here.
# Leave false on your own computer so http://localhost works.
COOKIE_SECURE=false

# How many proxies sit in front of the app. Use 1 behind Nginx or cPanel's Node.js setup, so login
# rate limits see each visitor's real address. Leave empty (off) when nothing is in front of the app.
TRUST_PROXY=

# Folder where uploaded images and PDFs are saved and served from (/uploads/...).
# Leave empty for server/uploads. On a host that wipes the app folder when you redeploy, point this
# to a folder outside it, for example /home/youruser/grownation-uploads.
UPLOAD_DIR=

# The public enquiry form is not on the site at the moment. Leave false: the enquiry address
# (POST /api/enquiries) then answers "not found" and sends no email. Set true only if the form comes back.
ENQUIRIES_ENABLED=false

# First Super admin (used only by `npm run init-db` when no users exist).
# If ADMIN_PASSWORD is empty or shorter than 10 characters, a random one is printed.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Email for new enquiries (only used when ENQUIRIES_ENABLED=true; without SMTP the enquiry is still saved)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Grow Nation <no-reply@example.com>

# ---- Vercel hosting (host branch) ----
# Cloud MySQL providers need an encrypted connection: set DB_SSL=true.
# Optionally paste the provider's CA certificate in DB_SSL_CA (one line, \n for line breaks).
DB_SSL=false
DB_SSL_CA=
# Vercel Blob token for uploaded images and PDFs. Vercel adds it automatically when you
# connect a Blob store to the project. Without it, uploads on Vercel are lost on the next restart.
BLOB_READ_WRITE_TOKEN=
